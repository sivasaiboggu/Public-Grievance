# GrievanceGrid Environment Configuration (.env.example)
# Copy this file to .env in your repo root before starting the stack.

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# Default: Local SQLite database for single-command development.
GG_DATABASE_URL=sqlite:///./var/grievancegrid.db

# Alternative: PostgreSQL container from docker-compose.dev.yml
# GG_DATABASE_URL=postgresql+psycopg://postgres:postgrespassword@127.0.0.1:5432/grievancegrid

# -----------------------------------------------------------------------------
# Cryptographic Security (REQUIRED TO BE CHANGED IN PRODUCTION)
# -----------------------------------------------------------------------------
# Secret key used for signing JWT auth tokens and HMAC photo evidence links.
# Must be at least 32 characters long.
# Generate one in PowerShell:
# -join ((65..90) + (97..122) + (48..57) | Get-Random -Count 48 | ForEach-Object {[char]$_})
GG_SECRET_KEY=dev-secret-key-change-in-production-min-32-chars

# -----------------------------------------------------------------------------
# Redis & Celery Background Queue
# -----------------------------------------------------------------------------
# Used for background email dispatch. If stopped, in-app notifications still work.
GG_REDIS_URL=redis://127.0.0.1:6379/0

# -----------------------------------------------------------------------------
# Email Configuration
# -----------------------------------------------------------------------------
# Options: "mailpit" (local GUI at http://localhost:8025), "console" (terminal), or "smtp"
GG_MAIL_BACKEND=mailpit
GG_MAILPIT_HOST=127.0.0.1
GG_MAILPIT_PORT=1025

# SMTP settings (used when GG_MAIL_BACKEND=smtp, e.g., Gmail App Password)
GG_SMTP_HOST=
GG_SMTP_PORT=587
GG_SMTP_USER=
GG_SMTP_PASSWORD=
GG_SMTP_FROM=no-reply@grievancegrid.test
GG_EMAIL_SENDER_NAME="City Municipality Team"

# -----------------------------------------------------------------------------
# Notification & Polling Hints
# -----------------------------------------------------------------------------
# Frequency in seconds that web and mobile apps poll for unread notifications (default: 15s)
NEXT_PUBLIC_NOTIFICATION_POLL_INTERVAL=15
# Interval in minutes for background overdue check
GG_OVERDUE_CHECK_INTERVAL_MINUTES=60

# -----------------------------------------------------------------------------
# Host & LAN Addresses for Web and Mobile (Phone)
# -----------------------------------------------------------------------------
# Web frontend URL
GG_FRONTEND_URL=http://localhost:3000

# API base URL for Web
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# LAN Address for Testing on a Physical Phone via Wi-Fi:
# Find your computer's IP using `ipconfig` (e.g. 192.168.1.15)
# Set EXPO_PUBLIC_API_URL to that IP so Expo Go on your phone can reach the backend.
EXPO_PUBLIC_API_URL=http://192.168.1.100:8000

# CORS Allowed Origins (include localhost and your LAN IP)
GG_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://192.168.1.100:3000"]

# -----------------------------------------------------------------------------
# Municipality Settings
# -----------------------------------------------------------------------------
GG_JURISDICTION_ID=demo-municipality
GG_JURISDICTION_NAME="Kochi Municipal Corporation"
GG_EMERGENCY_NUMBER=112

# -----------------------------------------------------------------------------
# Software Suggestions & Classifier Settings (Optional / Additive)
# -----------------------------------------------------------------------------
# Directory containing exported ONNX classifiers and thresholds.json
GG_ML_MODELS_DIR=./ml_assets/models
# Embedding model name for incident duplicate matching (paraphrase-multilingual-MiniLM-L12-v2 by default)
GG_EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Feature toggles (can also be toggled live by an Admin in Settings -> Suggestions)
GG_FEATURE_PHOTO_CHECK=true
GG_FEATURE_DUPLICATES=true
GG_FEATURE_PRIORITY=true
GG_FEATURE_ESCALATION=true

